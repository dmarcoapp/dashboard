# Copy this file to .env.local and fill in your values
# .env.local is ignored by version control

# API Configuration (override default)
VITE_API_BASE_URL=https://api.dmarco.app

# Disable/enable registration
VITE_DISABLE_REGISTRATION=false

# Mock Mode (set to 'false' to use real API)
VITE_MOCK_MODE=false

# Environment
NODE_ENV=development
