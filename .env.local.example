# Copy this file to .env.local and fill in your values
# .env.local is ignored by version control

# API Configuration (override default)
# Leave empty to use mock mode without a backend.
VITE_API_BASE_URL=

# Disable/enable registration
VITE_DISABLE_REGISTRATION=false

# Mock Mode (set to 'false' and configure VITE_API_BASE_URL to use a real API)
VITE_MOCK_MODE=true
